# Hedera Portal PAT (https://docs.hedera.com — create-api-key tutorial)
HEDERA_PORTAL_PAT=

DEPLOYER_PRIVATE_KEY=
HEDERA_ACCOUNT_ID=
OPERATOR_ID=
OPERATOR_KEY=
AGENT_PRIVATE_KEY=

# Hedera Testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Optional: Validation Cloud WebSocket for real-time events (eth_subscribe)
# Get API key: https://app.validationcloud.io — create Hedera testnet endpoint
# HEDERA_WS_URL=wss://testnet.hedera.validationcloud.io/v1/wss/<YOUR_API_KEY>
HEDERA_WS_URL=
HEDERA_NETWORK=hedera:testnet

# Contracts (deploy with: cd contracts && npm run deploy:hedera)
POOL_CONTRACT_ADDRESS=
YIELD_RESERVE_ADDRESS=
WHBAR_ADDRESS=0xb1F616b8134F602c3Bb465fB5b5e6565cCAd37Ed
# Circle official USDC on Hedera testnet (associate + faucet: https://faucet.circle.com)
USDC_TOKEN_ADDRESS=0.0.429274
USDC_EVM_ADDRESS=0x0000000000000000000000000000000000068cda
CHAINLINK_HBAR_USD_FEED=0x59bC155EB6c6C415fE43255aF66EcF0523c92B4a
CHAINLINK_MAX_STALENESS_SEC=86400
CHAINLINK_SWAP_TOLERANCE_BPS=200
SAUCERSWAP_USDC_EVM=0x0000000000000000000000000000000000001549
SAUCERSWAP_WHBAR_EVM=0x0000000000000000000000000000000000003ad2

# SaucerSwap V2 (Hedera testnet official deployments)
SAUCERSWAP_V2_ROUTER=0.0.1414040
SAUCERSWAP_ROUTER_EVM=0x0000000000000000000000000000000000159398
# Set true only when automation wallet holds SaucerSwap USDC (0.0.5449)
SAUCERSWAP_EXECUTE_SWAPS=false
SAUCERSWAP_V2_QUOTER=0.0.1390002
SAUCERSWAP_QUOTER_EVM=0x00000000000000000000000000000000001535b2
SAUCERSWAP_FACTORY_EVM=0x00000000000000000000000000000000001243ee
SAUCERSWAP_POOL_FEE=3000

# x402 (Blocky402 testnet facilitator — no API key required)
# Server receives only — NO private key on sell side (see x402-hedera-example pattern)
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
SELLER_ACCOUNT_ID=
SELLER_WALLET_ADDRESS=

# x402 buyer (agent pays for data — funded ECDSA testnet account from faucet)
# Alias names from https://github.com/matevszm/x402-hedera-example
HEDERA_CLIENT_ID=
HEDERA_CLIENT_KEY=
HEDERA_KEY_TYPE=ecdsa

# Backend
PORT=4000
# Backend (Neon PostgreSQL — pooled URL for Prisma Client)
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Agent services
AGENT_DATA_SERVICE_URL=http://localhost:4001
POOL_MONITOR_URL=http://localhost:4002

# Yield automation cron (hedera-automation/)
YIELD_CRON=0 0 */7 * *
EVENT_POLL_INTERVAL_MS=12000
CREDIT_RISK_ENABLED=true

# Demo wallets (optional)
LP_1_PRIVATE_KEY=
PSP_1_PRIVATE_KEY=
PSP_2_PRIVATE_KEY=

# Frontend
NEXT_PUBLIC_POOL_ADDRESS=
NEXT_PUBLIC_YIELD_RESERVE_ADDRESS=
NEXT_PUBLIC_WHBAR_ADDRESS=0xb1F616b8134F602c3Bb465fB5b5e6565cCAd37Ed
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000068cda
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_API_URL=http://localhost:4000/api
